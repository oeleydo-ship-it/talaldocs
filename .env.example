APP_NAME=Docs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=localhost

# First-visit installer (create superadmin at /install). Set false to disable.
APP_INSTALLER=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — production / CloudDeck should use PostgreSQL (shared .env).
# Pick ONE block. Do not leave a missing SQLite path during composer install.
# -----------------------------------------------------------------------------

# PostgreSQL (recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=docs
DB_USERNAME=docs
DB_PASSWORD=

# MySQL / MariaDB (alternative)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=docs
# DB_USERNAME=docs
# DB_PASSWORD=

# SQLite (local only)
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty when using php artisan serve on localhost.
# Set to .yourdomain.test only when using Laravel Herd/Valet with a wildcard domain.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "sync" for the simplest local setup (jobs run immediately).
# Use "database" or "redis" in production and run a queue worker (see README).
# `composer dev` starts serve + vite + queue:listen together.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=60
AI_FETCH_TIMEOUT=15
AI_MAX_FETCH_BYTES=524288
AI_FREE_MONTHLY_LIMIT=1

SCOUT_DRIVER=database

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

VITE_APP_NAME="${APP_NAME}"
